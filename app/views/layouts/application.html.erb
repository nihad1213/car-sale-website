<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Car Sale Website" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Car Sale Website">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous" defer></script> %>
  </head>

  <style>
  .brand-logo { font-weight: 800; letter-spacing: -.5px; }
  .brand-logo .bi { color: var(--bs-primary); }
  .filter-bar { background: #fff; border-bottom: 1px solid var(--bs-border-color); }
  .hero {
    background: linear-gradient(135deg, #0d1b2a 0%, #1b3a5c 100%);
    color: #fff;
  }
  .car-card { transition: transform .15s ease, box-shadow .15s ease; }
  .car-card:hover { transform: translateY(-4px); box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.12) !important; }
  .car-card .car-img { height: 200px; object-fit: cover; }
  .car-badge { position: absolute; top: .75rem; left: .75rem; }
  .fav-btn { position: absolute; top: .5rem; right: .5rem; border-radius: 50%; width: 36px; height: 36px; padding: 0; }
  .category-tile { transition: background .15s ease; }
  .category-tile:hover { background: var(--bs-primary-bg-subtle); }
</style>

  <body class="<%= 'has-admin-bar' if show_admin_bar? %>">
    <%= render "homepage/partials/admin_bar" if show_admin_bar? %>
    <%= yield %>
  </body>
</html>