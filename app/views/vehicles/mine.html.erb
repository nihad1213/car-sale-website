<%= render "homepage/partials/header" %>

<section class="bg-light py-5">
  <div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <h1 class="h3 fw-bold mb-0">My listings</h1>
      <%= link_to new_vehicle_path, class: "btn btn-primary btn-sm" do %>
        <i class="bi bi-plus-lg me-1"></i>Add a car
      <% end %>
    </div>

    <% if notice.present? %>
      <div class="alert alert-success shadow-sm"><%= notice %></div>
    <% end %>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
      <% @vehicles.each do |vehicle| %>
        <div class="col">
          <%= render "homepage/partials/vehicle_card", vehicle: vehicle, favorite_ids: @favorite_ids %>
          <div class="d-flex gap-2 mt-2">
            <%= link_to edit_vehicle_path(vehicle), class: "btn btn-outline-primary btn-sm flex-grow-1" do %>
              <i class="bi bi-pencil me-1"></i>Edit
            <% end %>
            <%= button_to vehicle_path(vehicle), method: :delete, class: "btn btn-outline-danger btn-sm",
                  form: { class: "m-0", data: { turbo_confirm: "Delete this listing?" } } do %>
              <i class="bi bi-trash"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <% if @vehicles.empty? %>
      <p class="text-muted text-center py-5">You haven't listed any cars yet.</p>
    <% end %>
  </div>
</section>

<%= render "homepage/partials/footer" %>