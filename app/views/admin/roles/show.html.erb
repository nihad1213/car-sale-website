<div class="d-flex flex-column flex-lg-row min-vh-100 bg-light">
  <%= render "admin/partials/sidebar" %>

  <main class="flex-grow-1 overflow-x-auto p-3 p-lg-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <div>
        <h1 class="h3 fw-bold mb-0"><%= @role.name %></h1>
        <small class="text-muted">Role details and assigned permissions.</small>
      </div>
      <div class="d-flex gap-2">
        <a href="<%= admin_roles_path %>" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i>Back to Roles
        </a>
        <a href="<%= edit_admin_role_path(@role) %>" class="btn btn-primary btn-sm">
          <i class="bi bi-pencil me-1"></i>Edit
        </a>
      </div>
    </div>

    <% if notice.present? %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i><%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-0 pt-3">
        <h2 class="h6 fw-bold mb-0 text-primary"><i class="bi bi-info-circle me-2"></i>General Information</h2>
      </div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-3">Name</dt>
          <dd class="col-sm-9"><%= @role.name %></dd>

          <dt class="col-sm-3">Users with this role</dt>
          <dd class="col-sm-9"><%= @role.users.count %></dd>

          <dt class="col-sm-3">Created by</dt>
          <dd class="col-sm-9">
            <%= @role.creator&.email || "—" %>
            <small class="text-muted ms-1"><%= l(@role.created_at, format: :short) %></small>
          </dd>

          <dt class="col-sm-3">Last updated by</dt>
          <dd class="col-sm-9 mb-0">
            <%= @role.updater&.email || "—" %>
            <small class="text-muted ms-1"><%= l(@role.updated_at, format: :short) %></small>
          </dd>
        </dl>
      </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-0 pt-3">
        <h2 class="h6 fw-bold mb-0 text-success">
          <i class="bi bi-shield-check me-2"></i>Permissions (<%= @role.permissions.size %>)
        </h2>
      </div>
      <div class="card-body">
        <% if @role.permissions.any? %>
          <div class="d-flex flex-wrap gap-2">
            <% @role.permissions.order(:name).each do |permission| %>
              <span class="badge text-bg-success-subtle border border-success-subtle text-success-emphasis fs-6 fw-normal">
                <%= permission.name %>
              </span>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted mb-0">No permissions assigned.</p>
        <% end %>
      </div>
    </div>
  </main>
</div>