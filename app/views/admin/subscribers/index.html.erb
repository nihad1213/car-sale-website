<div class="d-flex flex-column flex-lg-row min-vh-100 bg-light">
  <%= render "admin/partials/sidebar" %>

  <main class="flex-grow-1 overflow-x-auto p-3 p-lg-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <div>
        <h1 class="h3 fw-bold mb-0">Subscribers</h1>
        <small class="text-muted">Manage newsletter subscribers and send messages.</small>
      </div>

      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary fs-6">
          <%= @subscribers.count %> Subscribers
        </span>

        <%= link_to new_admin_newsletter_path, class: "btn btn-primary btn-sm" do %>
          <i class="bi bi-send me-1"></i>Send Newsletter
        <% end %>
      </div>
    </div>

    <% if notice.present? %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i><%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i><%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>

    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">#</th>
              <th>Email Address</th>
              <th>Subscribed At</th>
            </tr>
          </thead>

          <tbody>
            <% @subscribers.each_with_index do |subscriber, index| %>
              <tr>
                <td class="ps-3"><%= index + 1 %></td>
                <td class="fw-semibold">
                  <i class="bi bi-envelope text-primary me-2"></i>
                  <%= subscriber.email %>
                </td>
                <td>
                  <%= l(subscriber.created_at, format: :short) %>
                </td>
              </tr>
            <% end %>

            <% if @subscribers.empty? %>
              <tr>
                <td colspan="3" class="text-center text-muted py-4">
                  <i class="bi bi-envelope-open fs-4 d-block mb-2"></i>
                  No subscribers yet.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>