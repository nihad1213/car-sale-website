<div class="d-flex flex-column flex-lg-row min-vh-100 bg-light">
  <%= render "admin/partials/sidebar" %>

  <main class="flex-grow-1 overflow-x-auto p-3 p-lg-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <div>
        <h1 class="h3 fw-bold mb-0">Subscribers</h1>
        <small class="text-muted">Manage newsletter subscribers.</small>
      </div>

      <span class="badge bg-primary fs-6">
        <%= @subscribers.count %> Subscribers
      </span>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-0 py-3">
        <h2 class="h6 fw-bold mb-0 text-primary">
          <i class="bi bi-envelope me-2"></i>Subscriber List
        </h2>
      </div>

      <div class="card-body p-0">
        <% if @subscribers.any? %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-3">#</th>
                  <th>Email Address</th>
                  <th>Subscribed At</th>
                </tr>
              </thead>

              <tbody>
                <% @subscribers.each_with_index do |subscriber, index| %>
                  <tr>
                    <td class="ps-3"><%= index + 1 %></td>
                    <td>
                      <i class="bi bi-envelope text-primary me-2"></i>
                      <%= subscriber.email %>
                    </td>
                    <td>
                      <%= l(subscriber.created_at, format: :short) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-5">
            <i class="bi bi-envelope-open fs-1 text-muted"></i>
            <h6 class="fw-semibold mt-3">No subscribers yet</h6>
            <p class="text-muted small mb-0">
              Newsletter subscribers will appear here.
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>