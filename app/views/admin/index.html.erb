<style>
  .admin-dashboard { display: flex; min-height: 100vh; background: #f4f6fa; }
  .admin-dashboard > main { flex: 1; min-width: 0; padding: 2rem; }
  .stat-icon {
    width: 48px; height: 48px; border-radius: .75rem;
    display: inline-flex; align-items: center; justify-content: center; font-size: 1.4rem;
  }
  @media (max-width: 991.98px) {
    .admin-dashboard { flex-direction: column; }
    .admin-dashboard > main { padding: 1.25rem; }
  }
</style>

<%
  # Sample data - replace with real queries from your controller
  stats = [
    { label: "Total listings", value: "1,248", icon: "bi-car-front",  tone: "primary" },
    { label: "Active users",   value: "3,902", icon: "bi-people",     tone: "success" },
    { label: "Dealers",        value: "86",    icon: "bi-shop",       tone: "warning" },
    { label: "Pending review", value: "14",    icon: "bi-hourglass-split", tone: "danger" }
  ]
  recent = [
    { title: "2021 BMW 3 Series 320i", seller: "Elvin M.",   status: "Pending",  price: "$32,500" },
    { title: "2022 Tesla Model 3",     seller: "AutoHouse",  status: "Approved", price: "$41,800" },
    { title: "2019 Toyota Camry SE",   seller: "Rauf A.",    status: "Approved", price: "$21,900" },
    { title: "2017 Volkswagen Golf GTI", seller: "Nigar H.", status: "Rejected", price: "$18,700" }
  ]
  badge = { "Pending" => "warning", "Approved" => "success", "Rejected" => "danger" }
%>

<div class="admin-dashboard">
  <%= render "admin/partials/sidebar" %>

  <main>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <div>
        <h1 class="h3 fw-bold mb-0">Welcome to the Admin Dashboard</h1>
        <small class="text-muted"><%= Date.current.strftime("%A, %B %-d, %Y") %></small>
      </div>
    </div>

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
      <% stats.each do |s| %>
        <div class="col-6 col-xl-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
              <span class="stat-icon bg-<%= s[:tone] %>-subtle text-<%= s[:tone] %>">
                <i class="bi <%= s[:icon] %>"></i>
              </span>
              <div>
                <div class="h4 fw-bold mb-0"><%= s[:value] %></div>
                <small class="text-muted"><%= s[:label] %></small>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Recent listings -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
        <h2 class="h6 fw-bold mb-0">Recent listings</h2>
        <a href="/admin/cars" class="small text-decoration-none">View all</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Listing</th>
              <th>Seller</th>
              <th>Price</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% recent.each do |r| %>
              <tr>
                <td class="fw-semibold"><%= r[:title] %></td>
                <td><%= r[:seller] %></td>
                <td><%= r[:price] %></td>
                <td><span class="badge text-bg-<%= badge[r[:status]] %>"><%= r[:status] %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>