<div class="d-flex flex-column flex-lg-row min-vh-100 bg-light">
  <%= render "admin/partials/sidebar" %>

  <main class="flex-grow-1 overflow-x-auto p-3 p-lg-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <div>
        <h1 class="h3 fw-bold mb-0"><%= @contact_message.subject %></h1>
        <small class="text-muted">Received <%= l(@contact_message.created_at, format: :short) %></small>
      </div>
      <div class="d-flex gap-2">
        <a href="<%= admin_contact_messages_path %>" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i>Back to Messages
        </a>
        <a href="mailto:<%= @contact_message.email %>?subject=Re: <%= @contact_message.subject %>" class="btn btn-primary btn-sm">
          <i class="bi bi-reply me-1"></i>Reply
        </a>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <dl class="row mb-4">
          <dt class="col-sm-2">Name</dt>
          <dd class="col-sm-10"><%= @contact_message.name %></dd>
          <dt class="col-sm-2">Email</dt>
          <dd class="col-sm-10 mb-0"><%= mail_to @contact_message.email %></dd>
        </dl>
        <h2 class="h6 fw-bold text-primary"><i class="bi bi-chat-text me-2"></i>Message</h2>
        <%= simple_format(h(@contact_message.message)) %>
      </div>
    </div>
  </main>
</div>