<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<%
  cars = [
    { id: 1, title: "2021 BMW 3 Series 320i", year: 2021, price: 32500, mileage: 28000, fuel: "Petrol", transmission: "Automatic", location: "Baku", badge: "Featured" },
    { id: 2, title: "2019 Toyota Camry SE", year: 2019, price: 21900, mileage: 54000, fuel: "Petrol", transmission: "Automatic", location: "Baku", badge: nil },
    { id: 3, title: "2022 Tesla Model 3", year: 2022, price: 41800, mileage: 15000, fuel: "Electric", transmission: "Automatic", location: "Sumqayit", badge: "New" },
    { id: 4, title: "2018 Mercedes-Benz C200", year: 2018, price: 27300, mileage: 71000, fuel: "Diesel", transmission: "Automatic", location: "Ganja", badge: nil },
    { id: 5, title: "2020 Hyundai Tucson", year: 2020, price: 23400, mileage: 39000, fuel: "Petrol", transmission: "Automatic", location: "Baku", badge: nil },
    { id: 6, title: "2017 Volkswagen Golf GTI", year: 2017, price: 18700, mileage: 82000, fuel: "Petrol", transmission: "Manual", location: "Baku", badge: "Price drop" },
    { id: 7, title: "2023 Kia Sportage", year: 2023, price: 34900, mileage: 9000, fuel: "Hybrid", transmission: "Automatic", location: "Baku", badge: "New" },
    { id: 8, title: "2016 Ford Mustang GT", year: 2016, price: 29500, mileage: 63000, fuel: "Petrol", transmission: "Manual", location: "Mingachevir", badge: nil }
  ]
%>

<%= render "homepage/partials/header" %>

<main>
  <!-- ============ HERO ============ -->
  <section class="hero py-5">
    <div class="container py-lg-4">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <h1 class="display-5 fw-bold mb-3">
            Welcome to <span class="text-warning"><%= site_config.site_name %></span>
          </h1>
          <p class="lead mb-4 text-white-50">
            <%= site_config.tagline.presence || "Browse thousands of verified listings from trusted dealers and private sellers." %>
          </p>
          <div class="d-flex flex-wrap gap-2">
            <a href="#listings" class="btn btn-warning btn-lg px-4">Browse cars</a>
            <a href="#" class="btn btn-outline-light btn-lg px-4">Sell your car</a>
          </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block">
          <div class="row text-center g-3">
            <div class="col-4">
              <div class="display-6 fw-bold"><%= site_config.listings_count.presence || "12k+" %></div>
              <small class="text-white-50">Listings</small>
            </div>
            <div class="col-4">
              <div class="display-6 fw-bold"><%= site_config.dealers_count.presence || "45+" %></div>
              <small class="text-white-50">Dealers</small>
            </div>
            <div class="col-4">
              <div class="display-6 fw-bold"><%= site_config.satisfaction_rate.presence || "98%" %></div>
              <small class="text-white-50">Happy buyers</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BROWSE BY BODY TYPE ============ -->
  <section class="py-5">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="h4 fw-bold mb-0">Browse by body type</h2>
      <% if params[:body_type].present? %>
        <%= link_to root_path(anchor: "listings"), class: "btn btn-outline-secondary btn-sm" do %>
          <i class="bi bi-x-lg me-1"></i>Clear
        <% end %>
      <% end %>
      </div>
      <div class="row row-cols-3 row-cols-md-4 row-cols-lg-7 g-3">
      <% body_types.each do |body_type| %>
        <% active = params[:body_type] == body_type.name %>
        <div class="col">
          <%= link_to root_path(**request.query_parameters.symbolize_keys.except(:page),
                                body_type: (active ? nil : body_type.name), anchor: "listings"),
                class: "card category-tile border text-center text-decoration-none text-body h-100 #{'border-primary border-2 shadow-sm' if active}" do %>
            <div class="card-body py-3">
              <i class="<%= body_type.icon %> fs-2 text-primary"></i>
              <div class="small fw-semibold mt-1"><%= body_type.name %></div>
            </div>
          <% end %>
        </div>
      <% end %>
      </div>
    </div>
  </section>

  <!-- ============ LISTINGS ============ -->
  <section id="listings" class="pb-5">
    <div class="container">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
        <h2 class="h4 fw-bold mb-0">
          <%= params[:body_type].present? ? "#{params[:body_type]} listings" : "Latest listings" %>
        </h2>
        <small class="text-muted"><%= pluralize(@total, "car") %> found</small>
        </div>
        <div class="d-flex align-items-center gap-2">
          <label for="sort" class="small text-muted mb-0">Sort by</label>
        <select id="sort" class="form-select form-select-sm w-auto"
                onchange="const u = new URL(window.location); u.searchParams.set('sort', this.value); u.searchParams.delete('page'); u.hash = 'listings'; window.location = u;">
            <% { "newest" => "Newest first", "price_asc" => "Price: low to high", "price_desc" => "Price: high to low",
                 "year_desc" => "Year: newest", "mileage" => "Mileage: lowest" }.each do |value, label| %>
              <option value="<%= value %>" <%= "selected" if params[:sort] == value %>><%= label %></option>
            <% end %>
          </select>
        </div>
      </div>
  
      <% if @vehicles.any? %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <% @vehicles.each do |vehicle| %>
          <div class="col">
            <%= render "homepage/partials/vehicle_card", vehicle: vehicle, favorite_ids: @favorite_ids %>
          </div>
        <% end %>
        </div>
      <% else %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-car-front fs-1 d-block mb-2"></i>
          No cars match these filters.
        </div>
      <% end %>
  
      <% if @total_pages > 1 %>
        <nav class="mt-5" aria-label="Listings pagination">
          <ul class="pagination justify-content-center">
            <% base = request.query_parameters.symbolize_keys %>
            <li class="page-item <%= 'disabled' if @page <= 1 %>">
              <%= link_to "Previous", root_path(**base, page: @page - 1, anchor: "listings"), class: "page-link" %>
            </li>
            <% (1..@total_pages).each do |n| %>
              <li class="page-item <%= 'active' if n == @page %>">
                <%= link_to n, root_path(**base, page: n, anchor: "listings"), class: "page-link" %>
              </li>
            <% end %>
            <li class="page-item <%= 'disabled' if @page >= @total_pages %>">
              <%= link_to "Next", root_path(**base, page: @page + 1, anchor: "listings"), class: "page-link" %>
            </li>
          </ul>
        </nav>
      <% end %>
    </div>
  </section>

  <!-- ============ CONTACT US ============ -->
  <section id="contact" class="py-5">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="h4 fw-bold mb-1">Contact us</h2>
        <p class="text-muted small mb-0">Questions about a listing or selling your car? Send us a message.</p>
      </div>

      <div class="row g-4">
        <!-- Contact info -->
        <div class="col-lg-5">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
              <h3 class="h6 fw-bold mb-4">Get in touch</h3>

              <div class="d-flex mb-3">
                <i class="bi bi-geo-alt fs-4 text-primary me-3"></i>
                <div>
                  <div class="fw-semibold small">Address</div>
                  <div class="text-muted small"><%= site_config.address.presence || "Baku, Azerbaijan" %></div>
                </div>
              </div>

              <div class="d-flex mb-3">
                <i class="bi bi-telephone fs-4 text-primary me-3"></i>
                <div>
                  <div class="fw-semibold small">Phone</div>
                  <div class="text-muted small"><%= site_config.phone_number.presence || "+994 12 000 00 00" %></div>
                </div>
              </div>

              <div class="d-flex mb-3">
                <i class="bi bi-envelope fs-4 text-primary me-3"></i>
                <div>
                  <div class="fw-semibold small">Email</div>
                  <div class="text-muted small"><%= site_config.email.presence || "info@example.com" %></div>
                </div>
              </div>

              <div class="d-flex">
                <i class="bi bi-clock fs-4 text-primary me-3"></i>
                <div>
                  <div class="fw-semibold small">Working hours</div>
                  <div class="text-muted small">Mon – Sat, 09:00 – 18:00</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact form -->
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
              <%= render "contact_messages/form", contact_message: @contact_message || ContactMessage.new %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LATEST NEWS & BLOGS ============ -->
  <section class="bg-light py-5">
    <div class="container">
      <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Blog</h1>
        <p class="text-muted small mb-0">Buying guides, market trends, and maintenance tips.</p>
      </div>
  
      <div class="row g-4">
        <% @blogs.each do |blog| %>
          <div class="col-md-6 col-lg-4">
            <%= render "homepage/partials/single_blog", blog: blog %>
          </div>
        <% end %>
        <% if @blogs.empty? %>
          <p class="text-muted text-center py-5">No articles yet.</p>
        <% end %>
      </div>
    </div>
  </section>
</main>

<%= render "homepage/partials/footer" %>