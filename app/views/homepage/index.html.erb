<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  .brand-logo { font-weight: 800; letter-spacing: -.5px; }
  .brand-logo .bi { color: var(--bs-primary); }
  .filter-bar { background: #fff; border-bottom: 1px solid var(--bs-border-color); }
  .hero {
    background: linear-gradient(135deg, #0d1b2a 0%, #1b3a5c 100%);
    color: #fff;
  }
  .car-card { transition: transform .15s ease, box-shadow .15s ease; }
  .car-card:hover { transform: translateY(-4px); box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.12) !important; }
  .car-card .car-img { height: 200px; object-fit: cover; }
  .car-badge { position: absolute; top: .75rem; left: .75rem; }
  .fav-btn { position: absolute; top: .5rem; right: .5rem; border-radius: 50%; width: 36px; height: 36px; padding: 0; }
  .category-tile { transition: background .15s ease; }
  .category-tile:hover { background: var(--bs-primary-bg-subtle); }
</style>
<%
  cars = [
    { id: 1, title: "2021 BMW 3 Series 320i", year: 2021, price: 32500, mileage: 28000, fuel: "Petrol", transmission: "Automatic", location: "Baku", badge: "Featured" },
    { id: 2, title: "2019 Toyota Camry SE", year: 2019, price: 21900, mileage: 54000, fuel: "Petrol", transmission: "Automatic", location: "Baku", badge: nil },
    { id: 3, title: "2022 Tesla Model 3", year: 2022, price: 41800, mileage: 15000, fuel: "Electric", transmission: "Automatic", location: "Sumqayit", badge: "New" },
    { id: 4, title: "2018 Mercedes-Benz C200", year: 2018, price: 27300, mileage: 71000, fuel: "Diesel", transmission: "Automatic", location: "Ganja", badge: nil },
    { id: 5, title: "2020 Hyundai Tucson", year: 2020, price: 23400, mileage: 39000, fuel: "Petrol", transmission: "Automatic", location: "Baku", badge: nil },
    { id: 6, title: "2017 Volkswagen Golf GTI", year: 2017, price: 18700, mileage: 82000, fuel: "Petrol", transmission: "Manual", location: "Baku", badge: "Price drop" },
    { id: 7, title: "2023 Kia Sportage", year: 2023, price: 34900, mileage: 9000, fuel: "Hybrid", transmission: "Automatic", location: "Baku", badge: "New" },
    { id: 8, title: "2016 Ford Mustang GT", year: 2016, price: 29500, mileage: 63000, fuel: "Petrol", transmission: "Manual", location: "Mingachevir", badge: nil }
  ]
%>
<%= render "homepage/partials/header" %>

<main>
  <!-- ============ HERO ============ -->
  <section class="hero py-5">
    <div class="container py-lg-4">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <h1 class="display-5 fw-bold mb-3">Find your next car, <span class="text-warning">faster.</span></h1>
          <p class="lead mb-4 text-white-50">
            Browse thousands of verified listings from trusted dealers and private sellers.
            Compare prices, check history and drive away happy.
          </p>
          <div class="d-flex flex-wrap gap-2">
            <a href="#listings" class="btn btn-warning btn-lg px-4">Browse cars</a>
            <a href="#" class="btn btn-outline-light btn-lg px-4">Sell your car</a>
          </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block">
          <div class="row text-center g-3">
            <div class="col-4"><div class="display-6 fw-bold">12k+</div><small class="text-white-50">Listings</small></div>
            <div class="col-4"><div class="display-6 fw-bold">3k+</div><small class="text-white-50">Dealers</small></div>
            <div class="col-4"><div class="display-6 fw-bold">98%</div><small class="text-white-50">Happy buyers</small></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BROWSE BY BODY TYPE ============ -->
  <section class="py-5">
    <div class="container">
      <h2 class="h4 fw-bold mb-4">Browse by body type</h2>
      <div class="row row-cols-3 row-cols-md-4 row-cols-lg-7 g-3">
        <% [["Sedan", "bi-car-front"], ["SUV", "bi-truck-front"], ["Hatchback", "bi-car-front-fill"],
            ["Coupe", "bi-speedometer2"], ["Wagon", "bi-bus-front"], ["Pickup", "bi-truck"], ["Electric", "bi-lightning-charge"]].each do |name, icon| %>
          <div class="col">
            <a href="?body_type=<%= name %>" class="card category-tile border text-center text-decoration-none text-body h-100">
              <div class="card-body py-3">
                <i class="bi <%= icon %> fs-2 text-primary"></i>
                <div class="small fw-semibold mt-1"><%= name %></div>
              </div>
            </a>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- ============ LISTINGS ============ -->
  <section id="listings" class="pb-5">
    <div class="container">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
          <h2 class="h4 fw-bold mb-0">Latest listings</h2>
          <small class="text-muted"><%= cars.size %> cars found</small>
        </div>
        <div class="d-flex align-items-center gap-2">
          <label for="sort" class="small text-muted mb-0">Sort by</label>
          <select id="sort" name="sort" class="form-select form-select-sm w-auto">
            <option>Newest first</option>
            <option>Price: low to high</option>
            <option>Price: high to low</option>
            <option>Year: newest</option>
            <option>Mileage: lowest</option>
          </select>
        </div>
      </div>

      <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <% cars.each do |car| %>
          <div class="col">
            <div class="card car-card h-100 border-0 shadow-sm">
              <div class="position-relative">
                <img src="https://picsum.photos/seed/car<%= car[:id] %>/600/400"
                     class="card-img-top car-img" alt="<%= car[:title] %>" loading="lazy">
                <% if car[:badge] %>
                  <span class="badge text-bg-primary car-badge"><%= car[:badge] %></span>
                <% end %>
                <button type="button" class="btn btn-light fav-btn shadow-sm" aria-label="Save to favorites">
                  <i class="bi bi-heart"></i>
                </button>
              </div>

              <div class="card-body">
                <h3 class="h6 card-title mb-1"><%= car[:title] %></h3>
                <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i><%= car[:location] %></p>
                <p class="fs-5 fw-bold text-primary mb-3"><%= number_to_currency(car[:price], precision: 0) %></p>

                <ul class="list-unstyled small text-muted mb-0 row row-cols-2 g-1">
                  <li class="col"><i class="bi bi-calendar3 me-1"></i><%= car[:year] %></li>
                  <li class="col"><i class="bi bi-speedometer me-1"></i><%= number_with_delimiter(car[:mileage]) %> km</li>
                  <li class="col"><i class="bi bi-fuel-pump me-1"></i><%= car[:fuel] %></li>
                  <li class="col"><i class="bi bi-gear-wide-connected me-1"></i><%= car[:transmission] %></li>
                </ul>
              </div>

              <div class="card-footer bg-white border-0 pt-0 pb-3">
                <a href="#" class="btn btn-outline-primary btn-sm w-100">View details</a>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Pagination -->
      <nav class="mt-5" aria-label="Listings pagination">
        <ul class="pagination justify-content-center">
          <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
          <li class="page-item active"><a class="page-link" href="#">1</a></li>
          <li class="page-item"><a class="page-link" href="#">2</a></li>
          <li class="page-item"><a class="page-link" href="#">3</a></li>
          <li class="page-item"><a class="page-link" href="#">Next</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <!-- ============ WHY US ============ -->
  <section class="bg-light py-5">
    <div class="container">
      <h2 class="h4 fw-bold text-center mb-5">Why buy with RoRCar</h2>
      <div class="row g-4 text-center">
        <div class="col-md-4">
          <i class="bi bi-shield-check display-5 text-primary"></i>
          <h3 class="h6 fw-bold mt-3">Verified sellers</h3>
          <p class="text-muted small mb-0">Every dealer and private seller is checked before listing.</p>
        </div>
        <div class="col-md-4">
          <i class="bi bi-tags display-5 text-primary"></i>
          <h3 class="h6 fw-bold mt-3">Transparent pricing</h3>
          <p class="text-muted small mb-0">See price history and market comparisons for every car.</p>
        </div>
        <div class="col-md-4">
          <i class="bi bi-headset display-5 text-primary"></i>
          <h3 class="h6 fw-bold mt-3">Friendly support</h3>
          <p class="text-muted small mb-0">Our team helps with inspections, paperwork and delivery.</p>
        </div>
      </div>
    </div>
  </section>
</main>

<%= render "homepage/partials/footer" %>