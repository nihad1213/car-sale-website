<!-- ============ FOOTER ============ -->
<footer class="bg-dark text-white-50 pt-5 pb-4">
  <div class="container">
    <div class="row g-4">
      <!-- Brand & Tagline -->
      <div class="col-md-4">
        <a class="text-white fw-bold fs-5 text-decoration-none" href="/">
          <i class="bi bi-car-front-fill text-primary me-1"></i><%= site_config.site_name %>
        </a>
        <p class="small mt-2 mb-3">
          <%= site_config.tagline.presence || "The easiest way to buy and sell cars online." %>
        </p>

        <!-- Dynamic Contact Details -->
        <ul class="list-unstyled small text-white-50 mb-0">
          <% if site_config.email.present? %>
            <li class="mb-1"><i class="bi bi-envelope me-2 text-primary"></i><%= site_config.email %></li>
          <% end %>
          <% if site_config.phone_number.present? %>
            <li class="mb-1"><i class="bi bi-telephone me-2 text-primary"></i><%= site_config.phone_number %></li>
          <% end %>
          <% if site_config.address.present? %>
            <li><i class="bi bi-geo-alt me-2 text-primary"></i><%= site_config.address %></li>
          <% end %>
        </ul>
      </div>

      <!-- Links: Buy -->
      <div class="col-6 col-md-2">
        <h6 class="text-white">Buy</h6>
        <ul class="list-unstyled small">
          <li><a href="#" class="link-secondary text-decoration-none">New cars</a></li>
          <li><a href="#" class="link-secondary text-decoration-none">Used cars</a></li>
          <li><a href="#" class="link-secondary text-decoration-none">Electric</a></li>
        </ul>
      </div>

      <!-- Links: Sell -->
      <div class="col-6 col-md-2">
        <h6 class="text-white">Sell</h6>
        <ul class="list-unstyled small">
          <li><a href="#" class="link-secondary text-decoration-none">List your car</a></li>
          <li><a href="#" class="link-secondary text-decoration-none">Dealer tools</a></li>
        </ul>
      </div>

      <!-- Newsletter Subscription -->
      <div class="col-md-4">
        <h6 class="text-white">Stay updated</h6>
        <form class="input-group input-group-sm" action="#" method="post">
          <input type="email" class="form-control" placeholder="Your email" aria-label="Email">
          <button class="btn btn-primary" type="submit">Subscribe</button>
        </form>
      </div>
    </div>

    <hr class="border-secondary my-4">
    <p class="small text-center mb-0">&copy; <%= Date.current.year %> <%= site_config.site_name %>. All rights reserved.</p>
  </div>
</footer>