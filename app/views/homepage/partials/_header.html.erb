<!-- ============ HEADER ============ -->
<header class="sticky-top bg-white shadow-sm">
  <nav class="navbar navbar-expand-lg py-2">
    <div class="container">
      <a class="navbar-brand brand-logo fs-4 d-flex align-items-center gap-2" href="<%= root_path %>">
        <i class="bi bi-car-front-fill fs-3 text-primary"></i>
        <span><%= site_config.site_name %></span>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
              aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <%= form_with url: root_path(anchor: "listings"), method: :get, local: true,
              class: "d-flex flex-grow-1 mx-lg-4 my-3 my-lg-0", role: "search" do %>
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <%= search_field_tag :q, params[:q], class: "form-control",
                  placeholder: "Search by make, model or keyword...", "aria-label": "Search cars" %>
            <button class="btn btn-primary" type="submit">Search</button>
          </div>
        <% end %>

        <ul class="navbar-nav align-items-lg-center gap-lg-2">
          <!-- Saved -->
          <li class="nav-item">
            <% if current_user.present? %>
              <%= link_to favorites_path, class: "nav-link" do %>
                <i class="bi bi-heart me-1"></i>Saved
              <% end %>
            <% else %>
              <button type="button" class="nav-link btn btn-link"
                      data-bs-toggle="modal" data-bs-target="#authModal">
                <i class="bi bi-heart me-1"></i>Saved
              </button>
            <% end %>
          </li>

          <!-- Sell your car -->
          <li class="nav-item">
            <% if current_user.present? %>
              <%= link_to new_vehicle_path, class: "btn btn-outline-primary" do %>
                <i class="bi bi-plus-lg me-1"></i>Sell your car
              <% end %>
            <% else %>
              <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#authModal">
                <i class="bi bi-plus-lg me-1"></i>Sell your car
              </button>
            <% end %>
          </li>

          <!-- Profile -->
          <% if current_user.present? %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" id="profileMenu"
                 role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle fs-3"></i>
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="profileMenu">
                <li class="dropdown-header">Signed in as <strong><%= current_user.first_name %></strong></li>
                <% if current_user.admin? %>
                  <li><a class="dropdown-item text-primary" href="/admin"><i class="bi bi-speedometer2 me-2"></i>Admin Panel</a></li>
                <% end %>
                <li><a class="dropdown-item" href="<%= profile_path %>"><i class="bi bi-person me-2"></i>My profile</a></li>
                <li><a class="dropdown-item" href="<%= mine_vehicles_path %>"><i class="bi bi-card-list me-2"></i>My listings</a></li>
                <li><a class="dropdown-item" href="<%= favorites_path %>"><i class="bi bi-heart me-2"></i>Saved cars</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= button_to logout_path, method: :delete, class: "dropdown-item text-danger", form: { class: "m-0" } do %>
                    <i class="bi bi-box-arrow-right me-2"></i>Sign out
                  <% end %>
                </li>
              </ul>
            </li>
          <% else %>
            <li class="nav-item">
              <button type="button" class="nav-link btn btn-link d-flex align-items-center"
                      data-bs-toggle="modal" data-bs-target="#authModal" aria-label="Sign in or register">
                <i class="bi bi-person-circle fs-3"></i>
              </button>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Filters -->
  <%= render "homepage/partials/filters" %>
</header>

<%= render "homepage/partials/signinmodal" %>