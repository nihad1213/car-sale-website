<%
  cars = [
    { id: 1, title: "2021 BMW 3 Series 320i", year: 2021, price: 32500, mileage: 28000, fuel: "Petrol", transmission: "Automatic", location: "Baku", badge: "Featured" },
    { id: 2, title: "2019 Toyota Camry SE", year: 2019, price: 21900, mileage: 54000, fuel: "Petrol", transmission: "Automatic", location: "Baku", badge: nil },
    { id: 3, title: "2022 Tesla Model 3", year: 2022, price: 41800, mileage: 15000, fuel: "Electric", transmission: "Automatic", location: "Sumqayit", badge: "New" },
    { id: 4, title: "2018 Mercedes-Benz C200", year: 2018, price: 27300, mileage: 71000, fuel: "Diesel", transmission: "Automatic", location: "Ganja", badge: nil },
    { id: 5, title: "2020 Hyundai Tucson", year: 2020, price: 23400, mileage: 39000, fuel: "Petrol", transmission: "Automatic", location: "Baku", badge: nil },
    { id: 6, title: "2017 Volkswagen Golf GTI", year: 2017, price: 18700, mileage: 82000, fuel: "Petrol", transmission: "Manual", location: "Baku", badge: "Price drop" },
    { id: 7, title: "2023 Kia Sportage", year: 2023, price: 34900, mileage: 9000, fuel: "Hybrid", transmission: "Automatic", location: "Baku", badge: "New" },
    { id: 8, title: "2016 Ford Mustang GT", year: 2016, price: 29500, mileage: 63000, fuel: "Petrol", transmission: "Manual", location: "Mingachevir", badge: nil }
  ]
  years = (Date.current.year).downto(2000).to_a
  makes = %w[Audi BMW Ford Honda Hyundai Kia Mercedes-Benz Nissan Tesla Toyota Volkswagen]
  body_types = %w[Sedan SUV Hatchback Coupe Wagon Pickup Van]
%>

<!-- ============ HEADER ============ -->
<header class="sticky-top bg-white shadow-sm">
  <nav class="navbar navbar-expand-lg py-2">
    <div class="container">
      <!-- Logo using site_config -->
      <a class="navbar-brand brand-logo fs-4 d-flex align-items-center gap-2" href="/">
        <i class="bi bi-car-front-fill fs-3 text-primary"></i>
        <span><%= site_config.site_name %></span>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
              aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <!-- Search bar -->
        <form class="d-flex flex-grow-1 mx-lg-4 my-3 my-lg-0" role="search" action="<%= request.path %>" method="get">
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="search" name="q" class="form-control" placeholder="Search by make, model or keyword..."
                   aria-label="Search cars" value="<%= params[:q] %>">
            <button class="btn btn-primary" type="submit">Search</button>
          </div>
        </form>

        <!-- Right side navigation -->
        <ul class="navbar-nav align-items-lg-center gap-lg-2">
          <li class="nav-item">
            <a class="nav-link" href="#"><i class="bi bi-heart me-1"></i>Saved</a>
          </li>
          <li class="nav-item">
            <% if current_user.present? %>
              <a class="btn btn-outline-primary" href="#"><i class="bi bi-plus-lg me-1"></i>Sell your car</a>
            <% else %>
              <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#loginToSellModal">
                <i class="bi bi-plus-lg me-1"></i>Sell your car
              </button>
            <% end %>
          </li>
          
          <!-- Profile Dropdown -->
          <li class="nav-item dropdown">
            <% if current_user.present? %>
              <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" id="profileMenu"
                 role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle fs-3"></i>
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="profileMenu">
                <li class="dropdown-header">Signed in as <strong><%= current_user.first_name %></strong></li>
                <% if current_user.admin? %>
                  <li><a class="dropdown-item text-primary" href="/admin"><i class="bi bi-speedometer2 me-2"></i>Admin Panel</a></li>
                <% end %>
                <li><a class="dropdown-item" href="<%= profile_path %>"><i class="bi bi-person me-2"></i>My profile</a></li>
                <li><a class="dropdown-item" href="#"><i class="bi bi-card-list me-2"></i>My listings</a></li>
                <li><a class="dropdown-item" href="#"><i class="bi bi-heart me-2"></i>Saved cars</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= button_to logout_path, method: :delete, class: "dropdown-item text-danger", form: { class: "m-0" } do %>
                    <i class="bi bi-box-arrow-right me-2"></i>Sign out
                  <% end %>
                </li>
              </ul>
            <% else %>
              <button type="button" class="nav-link btn btn-link" data-bs-toggle="modal" data-bs-target="#authModal"
                      aria-label="Sign in or register">
                <i class="bi bi-person-circle fs-3"></i>
              </button>
            <% end %>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Filters -->
  <%= render "homepage/partials/filters" %>
</header>


<%= render "homepage/partials/signinmodal" %>