<div class="filter-bar">
  <div class="container py-2">
    <%= form_with url: root_path(anchor: "listings"), method: :get, local: true, class: "row g-2 align-items-end" do %>
      <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
      <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>

      <div class="col-6 col-md-3 col-lg-2">
        <label for="make" class="form-label small text-muted mb-1">Make</label>
        <%= select_tag :make, options_for_select(filter_makes, params[:make]),
              include_blank: "Any make", class: "form-select form-select-sm" %>
      </div>

      <div class="col-6 col-md-3 col-lg-2">
        <label for="model" class="form-label small text-muted mb-1">Model</label>
        <%= text_field_tag :model, params[:model], placeholder: "Any model", class: "form-control form-control-sm" %>
      </div>

      <div class="col-6 col-md-3 col-lg-2">
        <label for="year_from" class="form-label small text-muted mb-1">Year</label>
        <div class="input-group input-group-sm">
          <%= select_tag :year_from, options_for_select(filter_years, params[:year_from].to_i),
                include_blank: "From", class: "form-select" %>
          <%= select_tag :year_to, options_for_select(filter_years, params[:year_to].to_i),
                include_blank: "To", class: "form-select", "aria-label": "Year to" %>
        </div>
      </div>

      <div class="col-6 col-md-3 col-lg-2">
        <label for="price_min" class="form-label small text-muted mb-1">Price ($)</label>
        <div class="input-group input-group-sm">
          <%= number_field_tag :price_min, params[:price_min], placeholder: "Min", min: 0, step: 500, class: "form-control" %>
          <%= number_field_tag :price_max, params[:price_max], placeholder: "Max", min: 0, step: 500,
                class: "form-control", "aria-label": "Maximum price" %>
        </div>
      </div>

      <div class="col-6 col-md-3 col-lg-1">
        <label for="body_type" class="form-label small text-muted mb-1">Body</label>
        <%= select_tag :body_type, options_for_select(filter_body_types, params[:body_type]),
              include_blank: "Any", class: "form-select form-select-sm" %>
      </div>

      <div class="col-6 col-md-3 col-lg-1">
        <label for="fuel" class="form-label small text-muted mb-1">Fuel</label>
        <%= select_tag :fuel, options_for_select(Vehicle::FUELS, params[:fuel]),
              include_blank: "Any", class: "form-select form-select-sm" %>
      </div>

      <div class="col-12 col-md-6 col-lg-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
          <i class="bi bi-funnel me-1"></i>Filter
        </button>
        <a href="<%= root_path %>" class="btn btn-outline-secondary btn-sm" title="Reset filters">
          <i class="bi bi-arrow-counterclockwise"></i>
        </a>
      </div>
    <% end %>
  </div>
</div>