<%= render "homepage/partials/header" %>

<main class="container py-5" style="max-width: 720px;">
  <% if notice.present? %>
    <div class="alert alert-success shadow-sm"><i class="bi bi-check-circle-fill me-2"></i><%= notice %></div>
  <% end %>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h4 fw-bold mb-0">My profile</h1>
        <a href="<%= edit_profile_path %>" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
      </div>
      <dl class="row mb-0">
        <dt class="col-sm-4">First name</dt><dd class="col-sm-8"><%= @user.first_name %></dd>
        <dt class="col-sm-4">Last name</dt><dd class="col-sm-8"><%= @user.last_name %></dd>
        <dt class="col-sm-4">Email</dt><dd class="col-sm-8 mb-0"><%= @user.email %></dd>
      </dl>
    </div>
  </div>
</main>

<%= render "homepage/partials/footer" %>