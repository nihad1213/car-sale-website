<%= turbo_frame_tag "contact_form" do %>
  <%= form_with model: contact_message, url: contact_messages_path, class: "row g-3" do |f| %>
    <% if contact_message.errors.any? %>
      <div class="col-12">
        <div class="alert alert-danger shadow-sm mb-0">
          <ul class="mb-0 small">
            <% contact_message.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%# Honeypot: hidden from humans %>
    <div style="position:absolute; left:-9999px;" aria-hidden="true">
      <label for="website">Website</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
    </div>

    <div class="col-md-6">
      <%= f.label :name, "Your name", class: "form-label small fw-semibold" %>
      <%= f.text_field :name, class: "form-control", required: true, maxlength: 100 %>
    </div>
    <div class="col-md-6">
      <%= f.label :email, class: "form-label small fw-semibold" %>
      <%= f.email_field :email, class: "form-control", required: true %>
    </div>
    <div class="col-12">
      <%= f.label :subject, class: "form-label small fw-semibold" %>
      <%= f.select :subject, ContactMessage::SUBJECTS, {}, class: "form-select" %>
    </div>
    <div class="col-12">
      <%= f.label :message, class: "form-label small fw-semibold" %>
      <%= f.text_area :message, rows: 5, class: "form-control", required: true, minlength: 10, maxlength: 3000 %>
    </div>
    <div class="col-12">
      <button type="submit" class="btn btn-primary px-4">
        <i class="bi bi-send me-1"></i>Send message
      </button>
    </div>
  <% end %>
<% end %>